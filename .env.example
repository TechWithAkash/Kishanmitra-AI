# Copy to .env (docker compose reads it automatically). Every value is optional.

# Weather (primary source). Free key from https://home.openweathermap.org/api_keys (free plan is enough:
# current weather + 5-day forecast). New keys can take up to ~2 hours to activate.
# Without it, or if OpenWeather is down, the free Open-Meteo service is used automatically.
OPENWEATHER_API_KEY=

# Plant-photo diagnosis by AI: understands ANY crop and ANY plant part (fruit, stem, field), in the farmer's
# language. FREE key (Google account): https://aistudio.google.com/apikey . Without a key, only a small leaf
# model is used, which understands single leaves of a few crops. Photos are sent to Google when this is set.
GEMINI_API_KEY=
# Optional: a specific Gemini model (default: the latest "flash" model)
GEMINI_MODEL=
# Optional, paid alternative (used only if there is no Gemini key). Default model: claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Free key from https://data.gov.in (sign up → My Account → API key). Without it, live mandi
# prices use a public sample key that is often rate-limited.
DATA_GOV_API_KEY=

# Speech recognition model size: base (fast, ~150 MB) | small (default, ~500 MB) | medium (best, ~1.5 GB)
WHISPER_MODEL=small

# Port the web UI is published on
WEB_PORT=3000

# Requests per minute per client IP: normal endpoints / voice+photo endpoints
KISANMITRA_RATE_LIMIT=120
KISANMITRA_HEAVY_RATE_LIMIT=30

KISANMITRA_LOG_LEVEL=INFO

# When live mandi prices (and saved ones) are unavailable, show a clearly labelled ESTIMATE of the usual price
# range for the farmer's state and the time of year. It is not measured data. Set to 0 to show nothing instead.
KISANMITRA_ESTIMATED_PRICES=1

# Presentations only: when no real mandi prices exist, show built-in DEMO prices (invented numbers,
# labelled "Demo data"). Leave at 0 for real use: farmers must never see made-up prices.
KISANMITRA_DEMO_MODE=0

# Translation backup. Replies are translated with Google's free web endpoint, which sometimes
# rate-limits (HTTP 429). The backup, MyMemory, is OFF by default because its quality is poor
# ("kal baarish hogi kya" became "the Return of the Irish"). When Google fails, the farmer gets
# the English answer plus a notice. Set to 1 only if you accept lower-quality translations.
KISANMITRA_ALLOW_MYMEMORY=0

# Shown in the User-Agent sent to OpenStreetMap (their usage policy asks for contact details)
KISANMITRA_CONTACT=your-email@example.com
